# ============================================================
# Biến môi trường của agent. Dùng: cp .env.example .env rồi điền giá trị.
# File .env nằm trong .gitignore — KHÔNG commit secret thật.
# ============================================================

# Server
PORT=8000
ENVIRONMENT=development
APP_VERSION=1.0.0
LOG_LEVEL=INFO
WEB_CONCURRENCY=2

# Security — bắt buộc khi ENVIRONMENT=production (tạo bằng: python -c "import secrets; print(secrets.token_urlsafe(32))")
AGENT_API_KEY=

# State dùng chung cho rate limit và cost guard
REDIS_URL=redis://localhost:6379/0

# Giới hạn
RATE_LIMIT_PER_MINUTE=10
DAILY_BUDGET_USD=1.0
MONTHLY_BUDGET_USD=10.0
